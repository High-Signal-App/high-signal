# --- Operator API bearer ---
# Production is owned by the dedicated Infisical project. Never expose this to
# browser code; the web Worker injects it only after Cloudflare Access verifies
# the operator assertion.
ADMIN_TOKEN=

# --- AI provider (swappable baseURL pattern) ---
AI_BASE_URL=https://ai-gateway.sassmaker.com/v1
AI_API_KEY=
AI_MODEL=auto

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
VECTORIZE_INDEX_NAME=

# --- Ingestion sources ---
SEC_USER_AGENT=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_BEARER_TOKEN=
NEWS_API_KEY=

# --- App ---
NODE_ENV=development

# --- SaaS Maker ---
NEXT_PUBLIC_SAASMAKER_API_KEY=

# --- PostHog (@saas-maker/posthog-client) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
