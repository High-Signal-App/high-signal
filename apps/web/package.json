{
  "name": "@high-signal/web",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://highsignal.app",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack && node scripts/verify-company-profile-isr.mjs",
    "build:landing": "pnpm -C landing-astro build",
    "cf:build": "opennextjs-cloudflare build && node scripts/write-cache-build-id.mjs && node scripts/overlay-docs.mjs && READER_BUILD_MODE=profiles pnpm --filter @high-signal/reader build && node scripts/overlay-reader.mjs",
    "deploy": "pnpm cf:build && opennextjs-cloudflare deploy --tag \"$(git rev-parse HEAD)\"",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@high-signal/shared": "workspace:*",
    "@saas-maker/app-health": "https://github.com/sass-maker/app-health/releases/download/node-v0.4.0/saas-maker-app-health-0.4.0.tgz",
    "@saas-maker/ui": "github:sass-maker/ui-library#14712fdf622b5a02cb1cedb481356b6ad00a5132&path:/packages/ui",
    "jose": "6.2.10",
    "lucide-react": "1.11.0",
    "next": "16.4.1",
    "posthog-js": "^1.372.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "server-only": "0.0.1",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@playwright/test": "1.59.1",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/nextjs-vite": "10.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.19",
    "@types/node": "25.6.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "postcss": "8.5.18",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.1.6",
    "wrangler": "4.149.0"
  }
}
