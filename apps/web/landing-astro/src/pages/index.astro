---
import Layout from '../layouts/Layout.astro';

const TITLE = 'High Signal — Daily Technology, Startup, and Finance Brief';
const DESCRIPTION =
  'A daily brief from 20+ public sources across technology, startups, and finance. Every claim cites at least two independent sources or does not ship.';
---

<Layout title={TITLE} description={DESCRIPTION} pathname="/">
  <div class="mx-auto flex min-h-svh w-full max-w-6xl flex-col px-5 py-8 sm:px-6 sm:py-12">
    <header class="flex items-center justify-between gap-4 border-b border-[var(--color-line)] pb-6">
      <a href="/" class="text-sm font-medium tracking-tight text-[var(--color-fg)] no-underline">
        High Signal
      </a>
      <nav class="flex items-center gap-4 font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)]">
        <a href="/" class="no-underline hover:text-[var(--color-fg)]">Brief</a>
        <a href="/signals" class="no-underline hover:text-[var(--color-fg)]">Signals</a>
        <a href="/data" class="no-underline hover:text-[var(--color-fg)]">Sources</a>
        <a href="/track-record" class="no-underline hover:text-[var(--color-fg)]">Track record</a>
      </nav>
    </header>

    <main class="flex flex-1 flex-col justify-center py-10 sm:py-16">
      <header class="border-b border-[var(--color-line)] pb-8">
        <div class="flex items-baseline gap-3 font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-muted)]">
          <span class="size-1.5 rounded-full bg-[var(--color-accent)]"></span>
          <span>daily brief / global</span>
        </div>
        <h1 class="mt-4 text-5xl font-medium tracking-tight sm:text-6xl">What changed today</h1>
        <h2 class="mt-4 max-w-2xl text-sm font-normal leading-relaxed text-[var(--color-muted)] sm:text-base">
          We read 20+ public sources every day so you don&apos;t have to.
        </h2>
        <p class="hs-hero-copy mt-2 max-w-2xl text-sm leading-relaxed text-[var(--color-muted)] sm:text-base">
          SEC filings, Reddit, Hacker News, YouTube transcripts, GitHub, prediction markets,
          government feeds. Three public sections cover markets and companies, business
          opportunities, and behavior and culture. Every published signal cites at least two
          independent sources, or it does not ship. The result stays concise, current, and easy to
          verify.
        </p>
        <p class="mt-4 max-w-2xl font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-muted)]">
          Free and public · no reader account · empty sections beat unsupported claims
        </p>
      </header>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/"
          class="inline-flex h-11 items-center justify-center rounded-md bg-[var(--color-accent)] px-5 text-sm font-medium text-black no-underline transition-opacity hover:opacity-90"
        >
          Read today&apos;s brief
        </a>
        <a
          href="/signals"
          class="inline-flex h-11 items-center justify-center rounded-md border border-[var(--color-line)] px-5 text-sm font-medium text-[var(--color-fg)] no-underline transition-colors hover:border-[var(--color-muted)]"
        >
          Browse signals
        </a>
      </div>
    </main>

    <footer class="grid gap-6 border-t border-[var(--color-line)] py-8 text-xs text-[var(--color-muted)] sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
      <div>
        <p class="max-w-xl leading-5">
          High Signal is a free, public Daily Brief across technology, startups, and finance. No
          account or paid tier; evidence and the public hit-rate ledger remain inspectable.
        </p>
        <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.14em]">
          Every published signal cites at least two independent sources.
        </p>
      </div>
      <nav class="flex flex-wrap gap-x-4 gap-y-2 font-mono text-[10px] uppercase tracking-[0.14em]">
        <a href="/about">About</a>
        <a href="/methodology">Methodology</a>
        <a href="/privacy">Privacy</a>
        <a
          href="https://github.com/High-Signal-App/high-signal"
          aria-label="GitHub repository"
          title="GitHub repository"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center hover:text-[var(--color-fg)]"
        >
          <span class="sr-only">GitHub repository</span>
          <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true"
            ><path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            /></svg
          >
        </a>
      </nav>
    </footer>
  </div>
</Layout>
